# Copie este arquivo para .env.local e preencha com os dados do seu projeto
# Supabase (Project Settings > API no painel do Supabase).

VITE_SUPABASE_URL="https://SEU_PROJETO.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sua-chave-publicavel"

# Opcional: chave PUBLICA do widget Cloudflare Turnstile.
# Ative a protecao CAPTCHA no Supabase Auth somente depois de configurar
# a chave secreta no painel do Supabase e publicar esta variavel na Vercel.
VITE_TURNSTILE_SITE_KEY=""
