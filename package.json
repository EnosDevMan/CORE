  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check:dependencies": "npm audit --omit=dev --audit-level=high",
    "check:production": "node scripts/check-production-readiness.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run check:bundle && npm run check:dependencies && npm run check:production",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "@tailwindcss/vite": "^4.1.14",
